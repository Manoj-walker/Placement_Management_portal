# Copy to server/.env and fill in real values, then:
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run

# --- Local MySQL -----------------------------------------------------------
# The placement_nit database and its tables are created automatically.
DB_URL=jdbc:mysql://localhost:3306/placement_nit?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=manoj@123

# --- Security --------------------------------------------------------------
# Use at least 32 random characters in production.
JWT_SECRET=change-this-to-a-long-random-string-32chars-min

# --- Mail (optional; disabled by default) ----------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-smtp-user@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@placement.nit.edu

# --- App -------------------------------------------------------------------
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COLLEGE_EMAIL_DOMAIN=nit.edu
REMINDER_CRON=0 0 8 * * *
